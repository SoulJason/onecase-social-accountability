# Copy this file to `.env` and fill in the values from your Supabase project.
#
# Expo exposes any variable prefixed with EXPO_PUBLIC_ to the app at build time.
# The anon key is a *public* key (safe to ship) — real protection comes from
# Row-Level Security (RLS) in the database, not from hiding this key.
#
# Get these from: Supabase dashboard -> Project Settings -> API

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
